# Buzz production Docker Compose environment.
# Run ./bootstrap.sh --domain <domain> to generate .env from this template, or
# copy it to .env and replace every CHANGE_ME value by hand before running.

# Image published by the public image pipeline. Tag plus manifest-list digest is
# immutable while retaining a human-readable provenance hint. Re-resolve and test
# a new digest deliberately during upgrades.
BUZZ_IMAGE=ghcr.io/block/buzz:main@sha256:5290a17c172e8dcc67afe58450a2d5adef27f739d925a4afcbffbe9433345889

# Public host name. Used by compose.caddy.yml and URL-derived settings below.
BUZZ_DOMAIN=buzz.example.com
RELAY_URL=wss://buzz.example.com
BUZZ_MEDIA_BASE_URL=https://buzz.example.com/media
BUZZ_MEDIA_SERVER_DOMAIN=buzz.example.com
BUZZ_CORS_ORIGINS=https://buzz.example.com

# Production defaults. Closed relay mode requires RELAY_OWNER_PUBKEY and a stable relay key.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner identity. Set to a 64-character hex Nostr pubkey.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once, keep in .env, and back up securely.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media
# Bundled MinIO uses path-style URLs; deploy/compose/compose.yml pins this.
BUZZ_S3_ADDRESSING_STYLE=path

# Optional host ports. Base compose publishes the relay directly on BUZZ_HTTP_PORT.
BUZZ_HTTP_PORT=3000

# Caddy host ports. Only used with compose.caddy.yml.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Dev override ports. Only used with compose.dev.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8082
PROMETHEUS_PORT=9090

# Goose/OpenRouter agent (used when BUZZ_COMPOSE_AGENTS=true).
# Use the same public wss:// URL as Buzz Desktop; this preserves the community host.
BUZZ_AGENT_RELAY_URL=wss://buzz.example.com
# Agent identity generated by Buzz Desktop. Never reuse the relay or owner key.
BUZZ_AGENT_PRIVATE_KEY=CHANGE_ME_AGENT_NSEC_OR_64_HEX
# JSON-encoded NIP-OA `auth` tag issued by the owner for this agent. Single-quote
# the complete JSON value in .env so Compose preserves its punctuation.
BUZZ_AGENT_AUTH_TAG='CHANGE_ME_NIP_OA_AUTH_TAG_JSON'
# OpenRouter model slug discovered by Goose, for example vendor/model-name.
BUZZ_AGENT_MODEL=CHANGE_ME_OPENROUTER_MODEL_SLUG
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY
# One subprocess is sufficient for the first deployment. Range: 1-32.
BUZZ_AGENT_POOL_SIZE=5
# owner-only is the safe default; allowlist and anyone broaden inbound access.
BUZZ_AGENT_RESPOND_TO=owner-only
# 0 keeps the agent alive. Set seconds >0 to stop after inactivity.
BUZZ_AGENT_EXIT_AFTER_INACTIVITY=0
# auto is required for unattended tool execution inside this isolated container.
BUZZ_AGENT_GOOSE_MODE=auto

# Pi coding agent seat (optional). The pi-agent service in compose.agents.yml is
# gated behind the compose "pi" profile; enable with BUZZ_COMPOSE_PI=true
# (requires BUZZ_COMPOSE_AGENTS=true). All values below stay commented until you
# mint a dedicated identity for pi.
# BUZZ_COMPOSE_PI=true
# Dedicated pi agent identity. Never reuse the relay, owner, or goose keys.
# BUZZ_PI_AGENT_PRIVATE_KEY=CHANGE_ME_PI_NSEC_OR_64_HEX
# JSON-encoded NIP-OA `auth` tag issued by the owner for the pi agent.
# BUZZ_PI_AGENT_AUTH_TAG='CHANGE_ME_PI_NIP_OA_AUTH_TAG_JSON'
# Model notes: the primary pin is deploy/pi/settings.json, image-seeded into the
# fresh buzz-pi-home volume on first start. BUZZ_ACP_MODEL in compose.agents.yml
# is a secondary harness request. No BUZZ_PI_MODEL exists on purpose — pi-acp
# has no provider/model flag. The credential is OPENROUTER_API_KEY above.

# Team-wide instructions appended to every seat as BUZZ_ACP_TEAM_INSTRUCTIONS
# (compose.agents.yml references it once per service). This is the only lever
# that reaches all seats at once, so it is tracked here to survive a redeploy.
# Keep it one line: .env has no multiline support.
BUZZ_AGENT_TEAM_INSTRUCTIONS=CRITICAL: Your plain text output is NOT delivered to anyone. The ONLY way to reply is to call the buzz message-sending tool with the channel id and your content. Every time you are mentioned, you MUST call that tool before ending your turn. Ending a turn with only prose and no tool call means the person who asked you gets nothing. REPORTING LENGTH. Two cases, and getting them mixed up is the failure. (1) If a human asked for a specific artifact - a table, a report, a comparison, a list, a recommendation - deliver that artifact in full, in the channel, in the form they asked for. Do not shorten it, do not replace it with a file path, do not make them go fetch it. That is the deliverable and it belongs where they asked. (2) Otherwise - routine progress, coordination with Condor or another agent, or reporting a finished sub-task - send at most five short lines: the conclusion that actually changes the decision, the status (done / deferred / unverified / risk), and the path to the file holding your full evidence. In this case write the raw findings, working notes, citation dumps and command logs to a file under RESEARCH/ or WORK_LOGS/ in your workspace and cite it by path instead of pasting it. The five-line cap applies to your commentary, never to content the assignment explicitly asked you to include: if an assignment names an output, a command result or a figure, that content is part of the answer and must be in the message even when the message must stay short. A one-word or one-line reply that omits what was asked for is a failure, not brevity. In both cases: never restate another agent report back into the channel - if you agree with it, say so in one line and add only what is new - and never post a message whose only content is acknowledgement. Cut sentences that do not change a decision. Length is not thoroughness, but brevity is never an excuse for withholding something a human explicitly asked for. EPHEMERAL WORKING CHANNELS. Agent-to-agent coordination does not belong in a human's channel. When you and another agent need more than two exchanges to settle a sub-task - splitting scope, reconciling conflicting numbers, negotiating file ownership, iterating on a draft - open an ephemeral channel and do it there: buzz channels create --name <short-task-slug> --type stream --visibility private --ttl 86400, then add only the agents who must act. The relay archives it automatically once it goes idle for that long, so there is nothing to clean up. Post exactly two messages about it in the originating channel: one line when you open it, naming the channel and what it is for, and the result when you are done. Everything between those two lines happens in the ephemeral channel. Three hard limits. Never move a human's question into one: anything a human asked you for is answered in the channel where they asked, in full. Never open one for a single exchange - if one message settles it, send the one message. Never use one to hide a blocker: the moment the work needs a human decision, that decision request goes to the human's channel immediately, not after the sub-task finishes. Add the agents who must act with: buzz channels add-member --channel <uuid> --pubkey <hex>.
